---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const entries = (await getCollection('fair-years')).sort((a, b) => b.data.year - a.data.year);
const years = entries.map((e) => e.data.year);
---

<section class="fair" id="fair">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow">Joyful Spring Festival</div>
        <h2>{t('fairH')}</h2>
      </div>
    </div>
    <div class="years">
      {years.map((y) => <span>{y}</span>)}
    </div>
    <div class="grid g4">
      {entries.map((entry) => (
        <a class="card" href={entry.data.link}>
          <div class="thumb">
            {entry.data.thumbnail ? <img src={entry.data.thumbnail} alt="" loading="lazy" /> : entry.data.year}
          </div>
          <div class="body">
            <div class="tag">{entry.data.edition}</div>
            <h3>{entry.data.title}</h3>
            <div class="date">{entry.data.date.toISOString().slice(0, 10)}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
