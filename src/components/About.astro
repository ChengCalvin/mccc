---
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="about" style="background:var(--card)">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow">About</div>
        <h2>{t('aboutH')}</h2>
      </div>
    </div>
    <div class="ph">
      <h3>{t('aboutMissionTitle')}</h3>
      <p>{t('aboutP1')}</p>
      <p>{t('aboutP2')}</p>
    </div>
  </div>
</section>
