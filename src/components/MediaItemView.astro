---
import type { MediaItem } from '../lib/content-blocks';

interface Props {
  item: MediaItem;
}
const { item } = Astro.props;
---

{item.type === 'image' ? (
  <figure class="media-item">
    <img src={item.src} alt={item.alt} loading="lazy" />
    {item.caption && <figcaption>{item.caption}</figcaption>}
  </figure>
) : (
  <figure class="media-item media-item--video">
    <iframe
      src={item.src}
      title={item.title}
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    />
  </figure>
)}

<style>
  .media-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .media-item img {
    max-width: 100%;
    max-height: 60vh;
    width: auto;
    border-radius: var(--radius);
    object-fit: contain;
  }
  .media-item--video {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .media-item--video iframe {
    width: 100%;
    height: 100%;
    border-radius: var(--radius);
  }
  .media-item figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--ink-2);
    text-align: center;
  }
</style>
