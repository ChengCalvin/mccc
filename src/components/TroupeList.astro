---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const entries = (await getCollection('troupe')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section id="troupe">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow">Arts Troupe</div>
        <h2>{t('troupeH')}</h2>
      </div>
      <a class="more" href="https://www.mtlccc.net/?cat=4">{t('all')}</a>
    </div>
    <div class="grid g3">
      {entries.map((entry) => (
        <a class="card" href={entry.data.link}>
          <div class="thumb">
            {entry.data.image ? <img src={entry.data.image} alt="" loading="lazy" /> : entry.data.title}
          </div>
          <div class="body">
            <div class="tag">{entry.data.tag}</div>
            <h3>{entry.data.title}</h3>
            <div class="date">{entry.data.date.toISOString().slice(0, 10)}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
