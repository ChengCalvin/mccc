---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

function localize(locale: Locale, zh: string, en?: string, fr?: string): string {
  if (locale === 'en') return en ?? zh;
  if (locale === 'fr') return fr ?? zh;
  return zh;
}

const slides = (await getCollection('hero-slides'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    title: localize(locale, entry.data.title, entry.data.titleEn, entry.data.titleFr),
    image: entry.data.image,
  }));

const hasMultiple = slides.length > 1;
---

{slides.length > 0 && (
  <section class="hero" data-hero-carousel>
    {slides.map((slide, i) => (
      <div
        class={`slide${i === 0 ? ' active' : ''}`}
        data-slide-index={i}
        aria-hidden={i === 0 ? undefined : 'true'}
      >
        <img class="slide-img" src={slide.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="caption">
          <p class="caption-text">{slide.title}</p>
        </div>
      </div>
    ))}

    {hasMultiple && <p class="sr-only" data-hero-announce aria-live="polite" />}

    {hasMultiple && (
      <div class="hero-controls">
        <button type="button" class="hero-arrow prev" aria-label={t('heroPrevSlide')}>‹</button>
        <div class="hero-dots" role="group" aria-label="Slides">
          {slides.map((_, i) => (
            <button
              type="button"
              class={`hero-dot${i === 0 ? ' active' : ''}`}
              data-dot-index={i}
              aria-label={`${t('heroGoToSlidePrefix')} ${i + 1}${t('heroGoToSlideSuffix')}`}
              aria-pressed={i === 0}
            />
          ))}
        </div>
        <button type="button" class="hero-arrow next" aria-label={t('heroNextSlide')}>›</button>
      </div>
    )}
  </section>
)}

{hasMultiple && (
  <script>
    const ROTATE_INTERVAL_MS = 6000;

    document.querySelectorAll<HTMLElement>('[data-hero-carousel]').forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.hero-dot'));
      const prevBtn = carousel.querySelector<HTMLButtonElement>('.hero-arrow.prev');
      const nextBtn = carousel.querySelector<HTMLButtonElement>('.hero-arrow.next');
      const announce = carousel.querySelector<HTMLElement>('[data-hero-announce]');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      let active = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      function show(index: number) {
        active = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('active', i === active);
          if (i === active) slide.removeAttribute('aria-hidden');
          else slide.setAttribute('aria-hidden', 'true');
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === active);
          dot.setAttribute('aria-pressed', String(i === active));
        });
        if (announce) {
          announce.textContent = slides[active].querySelector('.caption-text')?.textContent ?? '';
        }
      }

      function next() {
        show(active + 1);
      }

      function prev() {
        show(active - 1);
      }

      function start() {
        if (reducedMotion || timer) return;
        timer = setInterval(next, ROTATE_INTERVAL_MS);
      }

      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      nextBtn?.addEventListener('click', next);
      prevBtn?.addEventListener('click', prev);
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => show(i));
      });

      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);

      start();
    });
  </script>
)}

<style lang="scss">
  .hero {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    align-items: end;
    color: #fff;
    background: var(--dark);
    padding: 0;
    overflow: hidden;

    @media (min-width: 720px) {
      aspect-ratio: auto;
      min-height: clamp(560px, 70vh, 760px);
    }

    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.8s ease;
      z-index: 0;

      &.active {
        opacity: 1;
        z-index: 1;
      }
    }

    .slide-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }

    .caption {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px;
      text-align: center;
      background: color-mix(in srgb, var(--dark) 45%, transparent);
    }

    .caption-text {
      margin: 0;
      max-width: 24em;
      font-size: clamp(22px, 3.2vw, 34px);
      font-weight: 700;
      text-wrap: balance;
    }

    .hero-controls {
      position: absolute;
      z-index: 3;
      inset-inline: 0;
      bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
    }

    .hero-arrow {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.6);
      background: color-mix(in srgb, var(--dark) 45%, transparent);
      color: #fff;
      font-size: 20px;
      line-height: 1;
      cursor: pointer;

      &:hover {
        background: color-mix(in srgb, var(--dark) 70%, transparent);
      }
    }

    .hero-dots {
      display: flex;
      gap: 8px;
    }

    .hero-dot {
      width: 10px;
      height: 10px;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.45);
      cursor: pointer;

      &.active {
        background: var(--gold);
      }
    }
  }
</style>
