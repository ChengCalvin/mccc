---
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="stats">
  <div class="wrap">
    <div><b>2017</b><span>{t('s1')}</span></div>
    <div><b>8</b><span>{t('s2')}</span></div>
    <div><b>25+</b><span>{t('s3')}</span></div>
    <div><b>3</b><span>{t('s4')}</span></div>
  </div>
</div>

<style lang="scss">
  .stats {
    background: var(--red);
    color: #fff;
    padding: 0;

    .wrap {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      padding-block: 22px;
      text-align: center;
    }

    b {
      display: block;
      font-size: 30px;
      line-height: 1.1;
    }

    span {
      font-size: 13px;
      opacity: 0.9;
    }

    @media (max-width: 640px) {
      .wrap {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  }
</style>
