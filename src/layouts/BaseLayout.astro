---
import '../styles/global.scss';
import { useTranslations, type Locale } from '../lib/i18n';
import { postsPath, aboutPath } from '../lib/routes';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const t = useTranslations(locale);
const htmlLang = locale === 'zh' ? 'zh-CN' : locale;

const localePath = (loc: Locale) => (loc === 'zh' ? '/' : `/${loc}/`);

// Preserve the current page when switching locales: strip the active
// locale's prefix off the URL, then re-prefix with the target locale.
const currentPath = Astro.url.pathname;
const pathWithoutLocale =
  locale === 'zh' ? currentPath : currentPath.replace(new RegExp(`^/${locale}(/|$)`), '/');
const switchLocalePath = (loc: Locale) =>
  loc === 'zh' ? pathWithoutLocale : `/${loc}${pathWithoutLocale}`.replace(/\/{2,}/g, '/');
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="top">
      <div class="wrap">
        <span>📍 1070A Anderson, Montreal, QC H2Z 1L9 &nbsp;·&nbsp; ☎ (514) 800-3860</span>
        <span class="lang" role="group" aria-label="Language">
          <a href={switchLocalePath('zh')} aria-pressed={locale === 'zh'}>中文</a>
          <a href={switchLocalePath('en')} aria-pressed={locale === 'en'}>EN</a>
          <a href={switchLocalePath('fr')} aria-pressed={locale === 'fr'}>FR</a>
          <button class="theme" id="theme" aria-label="Toggle theme">◐</button>
        </span>
      </div>
    </div>

    <header class="nav">
      <div class="wrap">
        <a class="logo" href={localePath(locale)}><img src="/images/logo.png" alt="MCCC 加拿大蒙特利尔华商会" /></a>
        <nav aria-label="Main">
          <ul>
            <li><a href={localePath(locale)}>{t('home')}</a></li>
            <li><a href={postsPath(locale)}>{t('navPosts')}</a></li>
            <li><a href={aboutPath(locale)}>{t('about')}</a></li>
            <li><a class="join" href={`${localePath(locale)}#membership`}>{t('join')}</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="cols">
          <div>
            <h4>MCCC · 加拿大蒙特利尔华商会</h4>
            <p>{t('footerTaglineEn')}<br />{t('footerTaglineFr')}</p>
          </div>
          <div>
            <h4>{t('footerExplore')}</h4>
            <ul>
              <li><a href={postsPath(locale)}>{t('fair')}</a></li>
              <li><a href={postsPath(locale)}>{t('act')}</a></li>
              <li><a href={postsPath(locale)}>{t('troupe')}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t('linksH')}</h4>
            <ul>
              <li>{t('linkImmigrationCanada')}</li>
              <li>{t('linkImmigrationQuebec')}</li>
              <li>{t('linkEmbassyShort')}</li>
              <li>{t('linkConsulateShort')}</li>
            </ul>
          </div>
        </div>
        <div class="legal">{t('footerLegal')}</div>
      </div>
    </footer>

    <script>
      const themeBtn = document.getElementById('theme');
      themeBtn?.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    </script>

    <script>
      document.querySelectorAll<HTMLElement>('[data-year-filter]').forEach((container) => {
        const rows = container.querySelectorAll<HTMLElement>('.row[data-year]');
        const yearPills = container.querySelectorAll<HTMLButtonElement>('.year-pill');
        const kindPills = container.querySelectorAll<HTMLButtonElement>('.kind-pill');
        const resetPills = container.querySelectorAll<HTMLButtonElement>('.reset-pill');
        const searchInput = container.querySelector<HTMLInputElement>('[data-search-input]');
        const defaultYears = (container.dataset.defaultYears ?? '').split(',').filter(Boolean);

        type Active = { type: 'year' | 'kind'; value: string } | null;
        let active: Active = null;

        function matchesActive(row: HTMLElement): boolean {
          if (!active) return defaultYears.length === 0 || defaultYears.includes(row.dataset.year ?? '');
          if (active.type === 'year') return row.dataset.year === active.value;
          return row.dataset.kind === active.value;
        }

        function matchesSearch(row: HTMLElement): boolean {
          const term = searchInput?.value.trim().toLowerCase() ?? '';
          if (term === '') return true;
          return (row.dataset.searchText ?? '').toLowerCase().includes(term);
        }

        function render() {
          rows.forEach((row) => {
            row.hidden = !matchesActive(row) || !matchesSearch(row);
          });
          yearPills.forEach((pill) => {
            pill.setAttribute('aria-pressed', String(active?.type === 'year' && pill.dataset.year === active.value));
          });
          kindPills.forEach((pill) => {
            pill.setAttribute('aria-pressed', String(active?.type === 'kind' && pill.dataset.kind === active.value));
          });
          resetPills.forEach((pill) => {
            pill.setAttribute('aria-pressed', String(active === null));
          });
        }

        yearPills.forEach((pill) => {
          pill.addEventListener('click', () => {
            active = { type: 'year', value: pill.dataset.year ?? '' };
            render();
          });
        });
        kindPills.forEach((pill) => {
          pill.addEventListener('click', () => {
            active = { type: 'kind', value: pill.dataset.kind ?? '' };
            render();
          });
        });
        resetPills.forEach((pill) => {
          pill.addEventListener('click', () => {
            active = null;
            render();
          });
        });
        searchInput?.addEventListener('input', render);

        render();
      });
    </script>
  </body>
</html>

<style lang="scss">
  .top {
    background: var(--dark);
    color: var(--on-dark);
    font-size: 13px;

    .wrap {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding-block: 8px;
      flex-wrap: wrap;
    }

    a:hover {
      color: var(--gold);
    }
  }

  .lang {
    a,
    button.theme {
      background: none;
      border: 1px solid #555;
      color: inherit;
      border-radius: 20px;
      padding: 2px 12px;
      font: inherit;
      cursor: pointer;
      margin-left: 6px;
      display: inline-block;
    }

    a[aria-pressed='true'] {
      background: var(--red);
      border-color: var(--red);
    }
  }

  header.nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--card);
    border-bottom: 3px solid var(--red);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);

    .wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-block: 10px;
    }

    @media (max-width: 820px) {
      .wrap {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  }

  .logo img {
    height: 52px;
    width: auto;
    background: #fff;
    border-radius: 6px;
    padding: 4px 8px;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 15px;

    &:hover {
      background: var(--gold-soft);
      color: var(--red);
    }

    &.join {
      background: var(--red);
      color: #fff;

      &:hover {
        background: var(--red-deep);
        color: #fff;
      }
    }
  }

  footer {
    background: var(--dark);
    color: var(--on-dark);
    padding-block: 44px 24px;
    font-size: 14px;

    .cols {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 28px;

      @media (max-width: 800px) {
        grid-template-columns: 1fr;
      }
    }

    h4 {
      margin: 0 0 10px;
      color: var(--gold);
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    li {
      margin: 6px 0;
    }

    a:hover {
      color: var(--gold);
    }

    .legal {
      border-top: 1px solid #444;
      margin-top: 26px;
      padding-top: 16px;
      color: #999;
    }
  }
</style>
